{
  "name": "wod-victims-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "check": "pnpm --filter @wod-victims/data-pipeline check",
    "validate:workspace": "pnpm --filter @wod-victims/data-pipeline validate:workspace",
    "ops:summary": "pnpm --filter @wod-victims/data-pipeline ops:summary",
    "discover:paalam": "pnpm --filter @wod-victims/data-pipeline discover:paalam",
    "scrape:paalam:batch": "pnpm --filter @wod-victims/data-pipeline scrape:paalam:batch",
    "scrape:paalam:sample": "pnpm --filter @wod-victims/data-pipeline scrape:paalam:sample",
    "review:paalam:scrape-quality": "pnpm --filter @wod-victims/data-pipeline review:paalam:scrape-quality",
    "prepare:paalam:extraction": "pnpm --filter @wod-victims/data-pipeline prepare:paalam:extraction",
    "validate:paalam:extraction": "pnpm --filter @wod-victims/data-pipeline validate:paalam:extraction"
  }
}
